---
interface Client {
  name: string;
  url: string;
  urlLabel: string;
}

const clients: Client[] = [
  {
    name: 'VW Suplementos BH',
    url: 'https://vwsuplementosbh.com.br/',
    urlLabel: 'vwsuplementosbh.com.br',
  },
];
---

<div class="clients-bar" aria-label="Sites que já entregamos">
  <div class="clients-bar__inner container">
    <span class="clients-bar__label">Já entregamos para</span>
    <span class="clients-bar__divider" aria-hidden="true"></span>
    <ul class="clients-bar__list" role="list">
      {clients.map((client) => (
        <li>
          <a
            class="clients-bar__chip"
            href={client.url}
            target="_blank"
            rel="noopener"
            aria-label={`Ver site de ${client.name}: ${client.urlLabel}`}
          >
            <span class="clients-bar__dot" aria-hidden="true"></span>
            <span class="clients-bar__name">{client.name}</span>
            <span class="clients-bar__url">{client.urlLabel}</span>
            <svg class="clients-bar__arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </a>
        </li>
      ))}
    </ul>
    <span class="clients-bar__divider" aria-hidden="true"></span>
    <a class="clients-bar__cta" href="#orcamento">
      Quer ter o seu?
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</div>

<style>
  .clients-bar {
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    background: rgba(20, 40, 68, 0.3);
    padding: 14px 0;
  }

  .clients-bar__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .clients-bar__label {
    font-family: var(--font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .clients-bar__divider {
    width: 1px;
    height: 16px;
    background: var(--border-medium);
    flex-shrink: 0;
  }

  .clients-bar__list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .clients-bar__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px 5px 8px;
    background: rgba(232, 90, 37, 0.07);
    border: 1px solid rgba(232, 90, 37, 0.18);
    border-radius: var(--radius-full);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .clients-bar__chip:hover {
    background: rgba(232, 90, 37, 0.14);
    border-color: rgba(232, 90, 37, 0.4);
  }

  .clients-bar__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.75); }
  }

  .clients-bar__name {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .clients-bar__url {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .clients-bar__chip:hover .clients-bar__url {
    color: var(--accent);
  }

  .clients-bar__arrow {
    color: var(--accent);
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .clients-bar__chip:hover .clients-bar__arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .clients-bar__cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }

  .clients-bar__cta:hover {
    opacity: 0.8;
    gap: 8px;
  }

  .clients-bar__cta svg {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .clients-bar__cta:hover svg {
    transform: translateX(2px);
  }
</style>
