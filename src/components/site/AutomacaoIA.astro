---
import { automation } from '@/data/site';
---

<section id="automacao" class="tz-section auto">
  <div class="tz-shell">
    <div class="auto__head">
      <div class="tz-eyebrow tz-eyebrow--light">
        <span class="tz-eyebrow__n">04</span>
        <span class="tz-eyebrow__label">Automação e IA</span>
      </div>
      <h2 class="tz-h2 auto__title">Automação devolve tempo para quem precisa fazer o negócio crescer.</h2>
    </div>

    <div class="auto__grid">
      {automation.map((a) => (
        <article class="auto__card">
          <span class="auto__from">{a.from}</span>
          <h3>{a.title}</h3>
          <p>{a.desc}</p>
        </article>
      ))}
    </div>

    <p class="auto__note"><span aria-hidden="true"></span>IA como ferramenta. Pessoas no centro das decisões.</p>
  </div>
</section>

<style>
  .auto { background: var(--tz-light); }
  .auto__head { display: flex; flex-direction: column; gap: 18px; max-width: 760px; }
  .auto__title { color: var(--tz-ink); }
  .auto__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .auto__card {
    background: #fff;
    border: 1px solid var(--tz-line);
    border-radius: var(--tz-r-xl);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    transition: transform .35s var(--tz-ease-back), box-shadow .35s;
  }
  .auto__card:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(15, 23, 42, 0.1); }
  .auto__from {
    font-size: 11px;
    font-weight: 700;
    color: var(--tz-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .auto__card h3 {
    font-size: 21px;
    font-weight: 700;
    color: var(--tz-ink);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .auto__card p { font-size: 14.5px; color: var(--tz-ink-soft); line-height: 1.6; margin: 0; }
  .auto__note {
    margin: 32px 0 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--tz-ink);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .auto__note span { width: 28px; height: 1px; background: var(--tz-accent); flex-shrink: 0; }
</style>
