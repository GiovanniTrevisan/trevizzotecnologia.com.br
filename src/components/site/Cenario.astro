---
import { scenario } from '@/data/site';
---

<section id="cenario" class="tz-section cen">
  <div class="tz-shell">
    <div class="cen__head">
      <div class="tz-eyebrow">
        <span class="tz-eyebrow__n">01</span>
        <span class="tz-eyebrow__label">O cenário</span>
        <span class="tz-eyebrow__rule"></span>
      </div>
      <h2 class="tz-h2">Oportunidades se perdem quando a operação não <em>acompanha o negócio</em>.</h2>
    </div>

    <div class="cen__grid">
      {scenario.map((s) => (
        <article class="cen__card">
          <span class="cen__n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cen { background: var(--tz-base); border-top: 1px solid var(--tz-border-soft); }
  .cen__head { display: flex; flex-direction: column; gap: 18px; max-width: 820px; }
  .cen__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .cen__card {
    background: var(--tz-glass);
    border: 1px solid rgba(232, 90, 37, 0.18);
    border-radius: var(--tz-r-xl);
    backdrop-filter: blur(20px);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform .35s var(--tz-ease-back), border-color .35s;
  }
  .cen__card:hover { transform: translateY(-3px); border-color: rgba(232, 90, 37, 0.4); }
  .cen__n { font-size: 13px; font-weight: 700; color: var(--tz-accent); letter-spacing: 0.16em; }
  .cen__card h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .cen__card p { font-size: 14.5px; color: var(--tz-text-2); line-height: 1.6; margin: 0; }
</style>
