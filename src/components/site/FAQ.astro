---
import { faqItems } from '@/data/faq';
import { WHATSAPP_URL } from '@/data/config';
---

<section id="faq" class="tz-section faq">
  <div class="tz-shell">
    <div class="faq__head">
      <div class="tz-eyebrow tz-eyebrow--light">
        <span class="tz-eyebrow__n">09</span>
        <span class="tz-eyebrow__label">Perguntas frequentes</span>
      </div>
      <h2 class="tz-h2 faq__title">O que costuma ser perguntado antes do primeiro projeto.</h2>
    </div>

    <div class="faq__grid">
      <div class="faq__list">
        {faqItems.map((item, i) => (
          <details class="faq__item" open={i === 0} name="tz-faq">
            <summary>
              <span class="faq__q">
                <span class="faq__cat">{item.category}</span>
                <span class="faq__question">{item.question}</span>
              </span>
              <span class="faq__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path class="faq__icon-v" d="M12 5v14"></path>
                </svg>
              </span>
            </summary>
            <div class="faq__answer"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>

      <aside class="faq__aside">
        <div class="faq__card">
          <h3>Prefere conversar antes?</h3>
          <p>Uma conversa curta é suficiente para entender o cenário e indicar o próximo passo.</p>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="faq__cta">Falar pelo WhatsApp</a>
          <a href="#diagnostico" class="faq__ghost">Preencher o formulário</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .faq { background: var(--tz-light); }
  .faq__head { display: flex; flex-direction: column; gap: 18px; max-width: 760px; }
  .faq__title { color: var(--tz-ink); }

  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
    margin-top: 44px;
    align-items: start;
  }
  .faq__list { display: flex; flex-direction: column; gap: 12px; }

  .faq__item {
    background: #fff;
    border: 1px solid var(--tz-line);
    border-radius: var(--tz-r-lg);
  }
  .faq__item[open] {
    border-color: rgba(232, 90, 37, 0.3);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .faq__cat {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--tz-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .faq__question { font-size: 16px; font-weight: 600; color: var(--tz-ink); line-height: 1.4; }
  .faq__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--tz-light);
    border: 1px solid var(--tz-line);
    color: var(--tz-ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .4s var(--tz-ease-back), background .3s, color .3s, border-color .3s;
  }
  .faq__item[open] .faq__icon {
    background: var(--tz-accent);
    border-color: transparent;
    color: #fff;
    transform: rotate(180deg);
  }
  .faq__item[open] .faq__icon-v { display: none; }
  .faq__answer { padding: 0 22px 20px; }
  .faq__answer p { font-size: 14.5px; color: var(--tz-ink-soft); line-height: 1.7; max-width: 680px; margin: 0; }

  .faq__card {
    background: linear-gradient(160deg, #1E3A5F, #0B1426);
    border-radius: var(--tz-r-xl);
    padding: 28px;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
  }
  .faq__card h3 { font-size: 20px; font-weight: 700; letter-spacing: -0.015em; margin: 0; }
  .faq__card p { font-size: 14px; color: #CBD5E1; line-height: 1.6; margin: 0; }
  .faq__cta,
  .faq__ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    border-radius: var(--tz-r-md);
    width: 100%;
  }
  .faq__cta { font-size: 15px; color: #fff; background: var(--tz-accent); padding: 14px 22px; }
  .faq__cta:hover { color: #fff; background: var(--tz-accent-hover); }
  .faq__ghost {
    font-size: 14px;
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    padding: 12px 22px;
  }
  .faq__ghost:hover { color: #fff; background: rgba(255, 255, 255, 0.09); }

  @media (min-width: 960px) {
    .faq__grid { grid-template-columns: 2fr 1fr; }
    .faq__aside { position: sticky; top: 100px; }
  }
</style>
