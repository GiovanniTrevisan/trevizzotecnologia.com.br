---
import { WHATSAPP_URL } from '@/data/config';
import Arrow from './Arrow.astro';
---

<section class="tz-section cta">
  <div class="tz-shell">
    <div class="cta__card">
      <div class="cta__glow" aria-hidden="true"></div>
      <span class="cta__kicker">Vamos identificar a melhor oportunidade?</span>
      <h2 class="cta__title">Onde sua empresa está perdendo oportunidades hoje?</h2>
      <p class="cta__lead">
        O diagnóstico é gratuito e termina em uma recomendação clara, com escopo e próximos passos definidos.
      </p>
      <div class="cta__actions">
        <a href="#diagnostico" class="tz-btn cta__btn">Iniciar diagnóstico<Arrow /></a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="tz-btn tz-btn--ghost">Falar pelo WhatsApp</a>
      </div>
      <p class="cta__domain">trevizzosolucoes.com.br</p>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--tz-base); overflow: hidden; }
  .cta__card {
    position: relative;
    background: rgba(20, 40, 68, 0.5);
    border: 1.5px solid rgba(232, 90, 37, 0.4);
    backdrop-filter: blur(20px);
    border-radius: var(--tz-r-2xl);
    padding: clamp(36px, 6vw, 72px);
    overflow: hidden;
    box-shadow: 0 0 60px rgba(232, 90, 37, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }
  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(232, 90, 37, 0.2), transparent 55%);
    pointer-events: none;
    z-index: 0;
  }
  .cta__card > *:not(.cta__glow) { position: relative; z-index: 1; }
  .cta__kicker {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tz-accent-soft);
  }
  .cta__title {
    font-size: clamp(28px, 4.2vw, 46px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 760px;
    text-wrap: balance;
  }
  .cta__lead { font-size: 16px; color: var(--tz-text-2); line-height: 1.65; max-width: 560px; margin: 0; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .cta__btn { border-radius: var(--tz-r-lg); padding: 18px 30px; box-shadow: 0 8px 28px rgba(232, 90, 37, 0.4); }
  .cta__domain { font-size: 13px; color: var(--tz-text-3); margin: 0; }
</style>
