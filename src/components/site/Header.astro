---
import { navItems } from '@/data/site';
import { WHATSAPP_URL } from '@/data/config';
import Arrow from './Arrow.astro';

interface Props {
  variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
const home = variant === 'light' ? '/' : '';
const logo = variant === 'light' ? '/images/logo.svg' : '/images/logo-dark.svg';
---

<header class:list={['hd', { 'hd--light': variant === 'light' }]} data-tz-header>
  <div class="hd__bar">
    <a href={variant === 'light' ? '/' : '#conteudo'} class="hd__logo" aria-label="Trevizzo Soluções, página inicial">
      <img src={logo} alt="Trevizzo Soluções" width="150" height="46" />
    </a>

    <nav class="hd__nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={`${home}${item.href}`} data-tz-navlink>{item.label}</a>
      ))}
    </nav>

    <div class="hd__actions">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="hd__wa">WhatsApp</a>
      <a href={`${home}#diagnostico`} class="hd__cta">Iniciar diagnóstico<Arrow size={16} /></a>
    </div>

    <div class="hd__mobile">
      <a href={`${home}#diagnostico`} class="hd__cta hd__cta--sm">Diagnóstico</a>
      <button class="hd__burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="tz-menu" data-tz-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="hd__progress" aria-hidden="true" data-tz-progress></div>
</header>

<div class="hd__menu" id="tz-menu" data-tz-menu hidden>
  {navItems.map((item) => (
    <a href={`${home}${item.href}`} data-tz-menulink>{item.label}<Arrow size={15} /></a>
  ))}
  <a href={`${home}#diagnostico`} class="hd__menucta" data-tz-menulink>Iniciar diagnóstico<Arrow size={17} /></a>
  <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="hd__menughost" data-tz-menulink>Falar pelo WhatsApp</a>
  <p>Diagnóstico primeiro. Recomendação e proposta depois.</p>
</div>

<style>
  .hd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(6, 11, 23, 0.32);
    border-bottom: 1px solid rgba(246, 248, 252, 0.02);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    transition: background .35s var(--tz-ease-expo), border-color .35s, box-shadow .35s;
  }
  .hd.is-scrolled {
    background: rgba(6, 11, 23, 0.88);
    border-bottom-color: rgba(246, 248, 252, 0.09);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .hd--light {
    background: rgba(255, 255, 255, 0.94);
    border-bottom-color: rgba(15, 23, 42, 0.07);
  }
  .hd--light.is-scrolled {
    background: rgba(255, 255, 255, 0.97);
    border-bottom-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  .hd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: var(--tz-shell);
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
    height: var(--tz-header-h);
  }

  .hd__logo { display: flex; align-items: center; flex-shrink: 0; transition: opacity .2s; }
  .hd__logo:hover { opacity: .75; }
  .hd__logo img { height: clamp(30px, 3.2vw, 36px); width: auto; display: block; }

  .hd__nav {
    display: none;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: var(--tz-r-full);
    background: rgba(246, 248, 252, 0.035);
    border: 1px solid rgba(246, 248, 252, 0.07);
  }
  .hd--light .hd__nav {
    background: rgba(15, 23, 42, 0.03);
    border-color: rgba(15, 23, 42, 0.07);
  }
  .hd__nav a {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border-radius: var(--tz-r-full);
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: rgba(246, 248, 252, 0.66);
    transition: color .2s, background .2s;
  }
  .hd--light .hd__nav a { color: var(--tz-ink-soft); }
  .hd__nav a:hover,
  .hd__nav a.is-active { color: var(--tz-text); background: rgba(246, 248, 252, 0.09); }
  .hd--light .hd__nav a:hover,
  .hd--light .hd__nav a.is-active { color: var(--tz-ink); background: rgba(15, 23, 42, 0.05); }

  .hd__actions { display: none; align-items: center; gap: 18px; flex-shrink: 0; }
  .hd__wa {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--tz-text-3);
    white-space: nowrap;
    transition: color .2s;
  }
  .hd__wa:hover { color: var(--tz-text); }
  .hd--light .hd__wa { color: var(--tz-ink-mute); }
  .hd--light .hd__wa:hover { color: var(--tz-ink); }

  .hd__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 22px;
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    color: #fff;
    background: var(--tz-accent);
    border-radius: var(--tz-r-full);
    box-shadow: 0 6px 18px rgba(232, 90, 37, 0.28);
    white-space: nowrap;
    transition: background .2s, transform .2s, box-shadow .2s;
  }
  .hd__cta:hover {
    color: #fff;
    background: var(--tz-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(232, 90, 37, 0.4);
  }
  .hd__cta--sm { height: 38px; padding: 0 16px; font-size: 13.5px; box-shadow: none; }

  .hd__mobile { display: flex; align-items: center; gap: 10px; }
  .hd__burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border-radius: var(--tz-r-md);
    background: rgba(246, 248, 252, 0.06);
    border: 1px solid rgba(246, 248, 252, 0.1);
    cursor: pointer;
    padding: 0;
  }
  .hd--light .hd__burger { background: rgba(15, 23, 42, 0.04); border-color: rgba(15, 23, 42, 0.1); }
  .hd__burger span {
    display: block;
    width: 18px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--tz-text);
    transition: transform .25s var(--tz-ease-expo), opacity .2s;
  }
  .hd--light .hd__burger span { background: var(--tz-ink); }
  .hd__burger.is-open span:nth-child(1) { transform: translateY(6.75px) rotate(45deg); }
  .hd__burger.is-open span:nth-child(2) { opacity: 0; }
  .hd__burger.is-open span:nth-child(3) { transform: translateY(-6.75px) rotate(-45deg); }

  .hd__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 0;
    background: linear-gradient(90deg, var(--tz-accent), #FF9A63);
    transition: width .1s linear;
  }

  .hd__menu {
    position: fixed;
    top: var(--tz-header-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    padding: 20px clamp(20px, 5vw, 32px) 32px;
    overflow-y: auto;
    background: rgba(6, 11, 23, 0.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    animation: tzMenuIn .28s var(--tz-ease-expo) both;
  }
  .hd__menu[hidden] { display: none; }
  .hd__menu > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--tz-text);
    padding: 18px 4px;
    border-bottom: 1px solid var(--tz-border-soft);
  }
  .hd__menucta {
    margin-top: 28px;
    justify-content: center !important;
    gap: 8px;
    font-size: 16px !important;
    color: #fff !important;
    background: var(--tz-accent);
    border-radius: var(--tz-r-full);
    padding: 16px 22px !important;
    border-bottom: none !important;
    box-shadow: 0 10px 26px rgba(232, 90, 37, 0.32);
  }
  .hd__menughost {
    margin-top: 10px;
    justify-content: center !important;
    font-size: 15px !important;
    border: 1px solid var(--tz-border-medium);
    border-radius: var(--tz-r-full);
    padding: 15px 22px !important;
    border-bottom: 1px solid var(--tz-border-medium) !important;
  }
  .hd__menu p {
    margin: auto 0 0;
    padding-top: 32px;
    font-size: 13px;
    color: var(--tz-text-3);
  }

  @media (min-width: 1024px) {
    .hd__nav, .hd__actions { display: flex; }
    .hd__mobile { display: none; }
    .hd__menu { display: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const header = document.querySelector('[data-tz-header]');
    const progress = document.querySelector('[data-tz-progress]');
    const burger = document.querySelector('[data-tz-burger]');
    const menu = document.querySelector('[data-tz-menu]');
    const links = Array.from(document.querySelectorAll('[data-tz-navlink]'));

    function closeMenu() {
      if (!menu || !burger) return;
      menu.hidden = true;
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Abrir menu');
      document.body.style.overflow = '';
    }

    if (burger && menu) {
      burger.addEventListener('click', function () {
        const open = menu.hidden;
        menu.hidden = !open;
        burger.classList.toggle('is-open', open);
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
        document.body.style.overflow = open ? 'hidden' : '';
      });
      document.querySelectorAll('[data-tz-menulink]').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });
      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024) closeMenu();
      });
    }

    function onScroll() {
      const y = window.scrollY || 0;
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if (header) header.classList.toggle('is-scrolled', y > 8);
      if (progress) progress.style.width = Math.min(100, (y / max) * 100).toFixed(2) + '%';

      let active = '';
      links.forEach(function (a) {
        const id = (a.getAttribute('href') || '').split('#')[1];
        const el = id && document.getElementById(id);
        if (!el) return;
        const r = el.getBoundingClientRect();
        if (r.top <= 140 && r.bottom > 140) active = id;
      });
      links.forEach(function (a) {
        const id = (a.getAttribute('href') || '').split('#')[1];
        a.classList.toggle('is-active', !!active && id === active);
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
