---
import { heroIndex } from '@/data/site';
import Arrow from './Arrow.astro';
---

<section id="conteudo" class="hero">
  <div class="hero__field" aria-hidden="true" data-tz-hero-field></div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__inner" data-tz-hero-par>
    <div class="hero__copy">
      <div class="hero__kicker">
        <span class="hero__rule"></span>
        <span>Trevizzo Soluções</span>
      </div>

      <h1 class="hero__title">
        <span>Tecnologia</span>
        <span>criada</span>
        <span>para</span>
        <span>fazer</span>
        <span>seu</span>
        <span>negócio</span>
        <span class="hero__accent">avançar.</span>
      </h1>

      <p class="hero__lead">
        Presença digital, automação e sistemas desenvolvidos a partir da realidade de cada empresa.
      </p>

      <div class="hero__actions">
        <a href="#diagnostico" class="tz-btn">Iniciar diagnóstico<Arrow /></a>
        <a href="#solucoes" class="hero__link">Ver como ajudamos<Arrow /></a>
      </div>
    </div>

    <div class="hero__index">
      <span class="hero__spine" aria-hidden="true"></span>
      <ul>
        {heroIndex.map((item) => (
          <li>
            <span class="hero__n">{item.n}</span>
            <span class="hero__label">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--tz-hero);
    padding: clamp(120px, 17vw, 160px) var(--tz-gutter) clamp(64px, 9vw, 96px);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hero__field { position: absolute; inset: 0; z-index: 0; }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(180deg, rgba(5, 9, 18, 0.92) 0%, rgba(5, 9, 18, 0.35) 46%, transparent 64%),
      radial-gradient(at 50% 108%, rgba(232, 90, 37, 0.2) 0px, transparent 55%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: var(--tz-shell);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .hero__copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.6vw, 30px);
  }
  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--tz-accent-soft);
    animation: tzFade .7s var(--tz-ease-expo) both;
  }
  .hero__rule {
    display: block;
    width: 56px;
    height: 2px;
    background: var(--tz-accent);
    transform-origin: left;
    animation: tzLine .9s var(--tz-ease-expo) .1s both;
  }
  .hero__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.24em;
    font-size: clamp(40px, 6.4vw, 82px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin: 0;
    max-width: 13ch;
  }
  .hero__title span {
    display: inline-block;
    animation: tzWord .9s var(--tz-ease-expo) both;
  }
  .hero__title span:nth-child(1) { animation-delay: .10s; }
  .hero__title span:nth-child(2) { animation-delay: .18s; }
  .hero__title span:nth-child(3) { animation-delay: .26s; }
  .hero__title span:nth-child(4) { animation-delay: .34s; }
  .hero__title span:nth-child(5) { animation-delay: .42s; }
  .hero__title span:nth-child(6) { animation-delay: .50s; }
  .hero__title span:nth-child(7) { animation-delay: .58s; }
  .hero__accent { color: var(--tz-accent); }

  .hero__lead {
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.55;
    color: var(--tz-text-2);
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
    animation: tzFade .8s var(--tz-ease-expo) .68s both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    animation: tzFade .8s var(--tz-ease-expo) .8s both;
  }
  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    font-size: 16px;
    color: var(--tz-text);
    border-bottom: 1px solid rgba(246, 248, 252, 0.25);
    padding-bottom: 3px;
    transition: border-color .25s, color .25s;
  }
  .hero__link:hover { color: var(--tz-text); border-color: var(--tz-accent); }

  .hero__index {
    flex: 0 1 260px;
    display: flex;
    gap: 22px;
    animation: tzFade .9s var(--tz-ease-expo) .92s both;
  }
  .hero__spine {
    display: block;
    width: 1px;
    background: linear-gradient(180deg, rgba(232, 90, 37, 0.6), rgba(246, 248, 252, 0.06));
  }
  .hero__index ul {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__index li { display: flex; flex-direction: column; gap: 3px; }
  .hero__n {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--tz-text-3);
  }
  .hero__label {
    font-size: 15.5px;
    font-weight: 500;
    color: rgba(246, 248, 252, 0.86);
  }
</style>

<script is:inline>
  (function () {
    const host = document.querySelector('[data-tz-hero-field]');
    const par = document.querySelector('[data-tz-hero-par]');
    if (!host) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js')
      .then(function (THREE) {
        const width = host.clientWidth || 1200;
        const height = host.clientHeight || 700;
        const light = window.matchMedia && window.matchMedia('(max-width: 760px)').matches;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(52, width / height, 0.1, 60);
        camera.position.set(0, 1.5, 7);
        camera.lookAt(0, -0.6, 0);

        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: !light, powerPreference: 'low-power' });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(light ? 1.5 : 2, window.devicePixelRatio || 1));
        renderer.domElement.style.display = 'block';
        renderer.domElement.style.width = '100%';
        renderer.domElement.style.height = '100%';
        host.appendChild(renderer.domElement);

        const group = new THREE.Group();
        const cols = light ? 46 : 86;
        const rows = light ? 20 : 36;
        const n = cols * rows;
        const pos = new Float32Array(n * 3);
        const rnd = new Float32Array(n);
        let i = 0;
        for (let z = 0; z < rows; z++) {
          for (let x = 0; x < cols; x++) {
            const jx = (Math.random() - 0.5) * 0.14;
            const jz = (Math.random() - 0.5) * 0.14;
            pos[i * 3] = (x / (cols - 1) - 0.5) * 27 + jx;
            pos[i * 3 + 1] = -2.2;
            pos[i * 3 + 2] = (z / (rows - 1)) * 17 - 13.5 + jz;
            rnd[i] = Math.random();
            i++;
          }
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        geo.setAttribute('aRand', new THREE.BufferAttribute(rnd, 1));

        const uniforms = {
          uTime: { value: 0 },
          uPointer: { value: new THREE.Vector2(0, -6) },
          uLift: { value: 0 },
          uOpacity: { value: 0 },
          uSize: { value: light ? 46 : 34 },
          uColor: { value: new THREE.Color(0xffc9b0) },
        };

        const mat = new THREE.ShaderMaterial({
          uniforms: uniforms,
          transparent: true,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
          vertexShader: [
            'attribute float aRand;',
            'uniform float uTime; uniform vec2 uPointer; uniform float uLift; uniform float uSize;',
            'varying float vFade; varying float vRand;',
            'void main(){',
            '  vec3 p = position;',
            '  float t = uTime;',
            '  p.y += sin(p.x * 0.30 + t * 0.16) * 0.30;',
            '  p.y += cos(p.z * 0.36 + t * 0.11) * 0.24;',
            '  p.y += sin((p.x * 0.09 + p.z * 0.12) + t * 0.055) * 0.55;',
            '  float d = distance(p.xz, uPointer);',
            '  float halo = exp(-d * d * 0.020);',
            '  p.y += halo * uLift * (0.85 + sin(d * 0.75 - t * 0.9) * 0.55);',
            '  vec4 mv = modelViewMatrix * vec4(p, 1.0);',
            '  float depth = clamp((-mv.z - 2.0) / 14.0, 0.0, 1.0);',
            '  vFade = (1.0 - depth * 0.85) * (0.45 + aRand * 0.55) + halo * 0.9;',
            '  vRand = aRand;',
            '  gl_PointSize = uSize * (0.55 + aRand * 0.75 + halo * 0.6) / max(-mv.z, 0.001);',
            '  gl_Position = projectionMatrix * mv;',
            '}',
          ].join('\n'),
          fragmentShader: [
            'uniform vec3 uColor; uniform float uOpacity;',
            'varying float vFade; varying float vRand;',
            'void main(){',
            '  float r = length(gl_PointCoord - 0.5);',
            '  float a = 1.0 - smoothstep(0.16, 0.5, r);',
            '  a *= a;',
            '  vec3 c = mix(uColor, vec3(1.0), vRand * 0.25);',
            '  gl_FragColor = vec4(c, a * vFade * uOpacity);',
            '}',
          ].join('\n'),
        });

        group.add(new THREE.Points(geo, mat));
        scene.add(group);

        const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 2.2);
        const ndc = new THREE.Vector2(0, 0);
        const ray = new THREE.Raycaster();
        const hit = new THREE.Vector3();
        const target = new THREE.Vector2(0, -6);
        const pointer = { x: 0, y: 0 };
        const smooth = { x: 0, y: 0 };
        let lift = 0;
        let over = 0;

        window.addEventListener('pointermove', function (e) {
          pointer.x = (e.clientX / window.innerWidth - 0.5) * 2;
          pointer.y = (e.clientY / window.innerHeight - 0.5) * 2;
          const r = host.getBoundingClientRect();
          const inside = e.clientY >= r.top && e.clientY <= r.bottom;
          over = inside ? 1 : 0;
          if (!inside) return;
          ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
          ray.setFromCamera(ndc, camera);
          if (ray.ray.intersectPlane(plane, hit)) target.set(hit.x, hit.z);
        }, { passive: true });

        window.addEventListener('resize', function () {
          const w = host.clientWidth || 800;
          const h = host.clientHeight || 300;
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
          renderer.setSize(w, h);
        });

        const clock = new THREE.Clock();
        const MAX_OP = light ? 0.34 : 0.42;

        function loop() {
          const t = clock.getElapsedTime();
          uniforms.uTime.value = t;

          smooth.x += (pointer.x - smooth.x) * 0.045;
          smooth.y += (pointer.y - smooth.y) * 0.045;
          uniforms.uPointer.value.x += (target.x - uniforms.uPointer.value.x) * 0.06;
          uniforms.uPointer.value.y += (target.y - uniforms.uPointer.value.y) * 0.06;
          lift += ((over ? (light ? 0.5 : 0.9) : 0) - lift) * 0.04;
          uniforms.uLift.value = lift;

          const vh = window.innerHeight || 800;
          const rect = host.getBoundingClientRect();
          const p = Math.max(-1, Math.min(1, (vh / 2 - (rect.top + rect.height / 2)) / vh));
          const vis = Math.max(0, Math.min(1, 1 - Math.max(0, p) * 1.15));
          uniforms.uOpacity.value += (MAX_OP * vis - uniforms.uOpacity.value) * 0.08;

          group.rotation.y = smooth.x * 0.22;
          group.rotation.x = smooth.y * 0.06 + p * 0.05;
          group.position.y = p * 1.1 + smooth.y * 0.35;
          camera.position.z = 7 - p * 1.9;
          camera.position.x = smooth.x * 0.5;
          camera.lookAt(0, -0.6 + p * 0.3, 0);

          if (par) par.style.transform = 'translate3d(0,' + (p * -34).toFixed(2) + 'px,0)';
          renderer.render(scene, camera);
          requestAnimationFrame(loop);
        }
        loop();
      })
      .catch(function () { /* sem 3D: o hero segue com o gradiente */ });
  })();
</script>
