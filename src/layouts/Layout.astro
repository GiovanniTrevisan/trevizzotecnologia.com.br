---
import '@/styles/global.css';
import '@/styles/site-v2.css';
// Self-hosted Poppins (static, since Google Fonts never published Poppins as
// a variable font — @fontsource-variable/poppins does not exist). Only the
// weights actually used in the codebase: 400 (default), 500, 600, 700, 800.
// Weight 300 (previously requested from Google Fonts) is used nowhere.
//
// Latin subsets only. The bare `@fontsource/poppins/400.css` entrypoints also
// pull the devanagari subset (~39 KB per weight, ~196 KB total) that a pt-BR
// site never renders. Portuguese diacritics (ç ã õ á é í ó ú â ê ô) all live in
// Latin-1 Supplement, so `latin` covers the site; `latin-ext` is kept as cheap
// insurance — unicode-range gates the download, so an unused subset costs
// nothing at runtime.
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import '@fontsource/poppins/latin-ext-400.css';
import '@fontsource/poppins/latin-ext-500.css';
import '@fontsource/poppins/latin-ext-600.css';
import '@fontsource/poppins/latin-ext-700.css';
import '@fontsource/poppins/latin-ext-800.css';
// Resolved to the real, content-hashed build URL — never hand-write this
// path, the hash changes on every font update.
// @ts-expect-error Vite's `?url` import has no ambient type here.
import poppinsBoldWoff2 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { SITE_URL, SITE_NAME, abs } from '@/data/config';

interface Props {
  title?: string;
  description?: string;
  /** Overrides the canonical URL. Defaults to the current path. */
  canonical?: string;
  /** Overrides the OG/Twitter image. Defaults to the default OG card. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** JSON-LD nodes this page emits. Defaults to none — every page declares
   * explicitly what it emits instead of Layout injecting schema that may
   * not match the page's actual rendered content. */
  schemas?: object[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title = 'Trevizzo Soluções — Presença digital, automação e sistemas sob medida',
  description =
    'Presença digital, automação com IA e sistemas sob medida desenvolvidos a partir da realidade de cada empresa. O projeto começa por um diagnóstico gratuito.',
  canonical,
  image,
  imageAlt = SITE_NAME,
  noindex = false,
  schemas = [],
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, SITE_URL + '/');

// og-default.png is generated by scripts/generate-og.mjs and committed to
// public/images/. It is authored at 1200x630 for summary_large_image. If it
// is ever missing, fall back to the truthfully-declared 1024x1024 icon.png
// under twitter:card=summary instead of lying about dimensions.
const OG_DEFAULT_PATH = 'images/og-default.png';
const ogDefaultFsPath = fileURLToPath(new URL('../../public/images/og-default.png', import.meta.url));
const ogImageOk = existsSync(ogDefaultFsPath);

const resolvedImage = image ?? (ogImageOk ? abs(OG_DEFAULT_PATH) : abs('images/icon.png'));
const imageWidth = image ? undefined : ogImageOk ? 1200 : 1024;
const imageHeight = image ? undefined : ogImageOk ? 630 : 1024;
const twitterCard = image ? 'summary_large_image' : ogImageOk ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="_ihAGe2jhXh_t4eNFeHqcOH9UpNK63VdwN-6w03aDmg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060B17" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Trevizzo Soluções — Grupo Yuzan" />
    <meta
      name="robots"
      content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon-180.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:type" content="image/png" />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Fonts: self-hosted via @fontsource/poppins (imported above). Preload
    the weight/subset used by the <h1> (700, Latin) so it isn't discovered
    only after CSS parses — this is the LCP element on the homepage. -->
    <link rel="preload" as="font" type="font/woff2" href={poppinsBoldWoff2} crossorigin />

    <!-- JSON-LD -->
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a href="#conteudo" class="tz-skip">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
