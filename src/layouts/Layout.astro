---
import '@/styles/global.css';
import '@/styles/site-v2.css';
import { faqItems } from '@/data/faq';
import { SITE_URL, SITE_NAME, COMPANY_LEGAL_NAME, COMPANY_CNPJ } from '@/data/config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Trevizzo Soluções — Presença digital, automação e sistemas sob medida',
  description =
    'Presença digital, automação com IA e sistemas sob medida desenvolvidos a partir da realidade de cada empresa. O projeto começa por um diagnóstico gratuito.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  legalName: COMPANY_LEGAL_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}images/logo.svg`,
  taxID: COMPANY_CNPJ,
  foundingDate: '2026-04',
  parentOrganization: { '@type': 'Organization', name: 'Grupo Yuzan' },
  sameAs: [],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE_NAME,
  description,
  url: SITE_URL,
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Barueri', addressRegion: 'SP', addressCountry: 'BR' },
    { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'MG', addressCountry: 'BR' },
  ],
  areaServed: ['Barueri', 'Alphaville', 'São Paulo', 'Belo Horizonte', 'Brasil'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Soluções digitais',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Presença digital', description: 'Sites, landing pages, lojas, catálogos, SEO e presença no Google.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Automação e IA', description: 'Automações e inteligência artificial aplicadas a atendimento e organização de informações.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Sistemas sob medida', description: 'Sistemas e plataformas desenvolvidos para o fluxo real da empresa.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Software por assinatura', description: 'Produtos digitais que podem ser comercializados por assinatura.' } },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="_ihAGe2jhXh_t4eNFeHqcOH9UpNK63VdwN-6w03aDmg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060B17" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Trevizzo Soluções — Grupo Yuzan" />
    <meta
      name="keywords"
      content="presença digital, criação de site, automação, inteligência artificial, sistemas sob medida, software por assinatura, Barueri, Alphaville, Belo Horizonte"
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={`${SITE_URL}images/icon.png`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Trevizzo Soluções" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}images/icon.png`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a href="#conteudo" class="tz-skip">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
