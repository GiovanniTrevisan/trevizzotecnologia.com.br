---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/site/Header.astro';
import Breadcrumb from '@/components/site/Breadcrumb.astro';
import Hero from '@/components/site/Hero.astro';
import ServiceBody from '@/components/site/ServiceBody.astro';
import AutomacaoIA from '@/components/site/AutomacaoIA.astro';
import Processo from '@/components/site/Processo.astro';
import Experiencia from '@/components/site/Experiencia.astro';
import FAQ from '@/components/site/FAQ.astro';
import Diagnostico from '@/components/site/Diagnostico.astro';
import FinalCTA from '@/components/site/FinalCTA.astro';
import Footer from '@/components/site/Footer.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import Arrow from '@/components/site/Arrow.astro';
import { organization, webPage, breadcrumb, service } from '@/data/schema';
import { faqItems } from '@/data/faq';
import { services, getService } from '@/data/services';
import { abs } from '@/data/config';

const svc = getService('automacao-e-ia');
const pageUrl = abs('automacao-e-ia/');
const trail = [
  { name: 'Início', url: abs('') },
  { name: svc.navLabel, url: pageUrl },
];
const faq = [
  ...svc.faqSpecific,
  ...faqItems.filter((f) => f.category && svc.faqGenericCategories.includes(f.category)),
];
const otherServices = services.filter((s) => s.slug !== svc.slug);
---

<Layout
  title={svc.title}
  description={svc.description}
  schemas={[
    organization({ includeOfferCatalog: true }),
    webPage({ url: pageUrl, name: svc.title, description: svc.description }),
    breadcrumb(trail),
    service({
      name: 'Automação e IA',
      description: 'Automações e inteligência artificial aplicadas a atendimento e organização de informações.',
      url: pageUrl,
      serviceType: 'Automação de atendimento e inteligência artificial',
    }),
  ]}
>
  <Header home={true} />
  <div class="bc-bar">
    <div class="tz-shell">
      <Breadcrumb trail={trail} variant="dark" />
    </div>
  </div>
  <main id="conteudo">
    <Hero
      kicker={svc.kicker}
      words={svc.heroWords}
      accentFrom={svc.accentFrom}
      lead={svc.lead}
      showIndex={false}
      showField={false}
      ctaSecondary={svc.ctaSecondary}
    />

    <ServiceBody sections={svc.sections} theme={svc.bodyTheme} />
    <AutomacaoIA />
    <Processo />
    <Experiencia items={svc.experienceItems} />
    <FAQ items={faq} />

    <section class="tz-section svc-cross">
      <div class="tz-shell svc-cross__inner">
        <span class="svc-cross__label">Outras soluções</span>
        <div class="svc-cross__links">
          {otherServices.map((s) => (
            <a href={`/${s.slug}/`} class="svc-cross__link">{s.navLabel}<Arrow size={15} /></a>
          ))}
        </div>
      </div>
    </section>

    <Diagnostico />
    <FinalCTA />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .bc-bar {
    background: var(--tz-base);
    padding: calc(var(--tz-header-h) + 20px) var(--tz-gutter) 0;
  }
  .svc-cross { background: var(--tz-base); border-top: 1px solid var(--tz-border-soft); }
  .svc-cross__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
  .svc-cross__label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tz-text-3);
  }
  .svc-cross__links { display: flex; flex-wrap: wrap; gap: 14px; }
  .svc-cross__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--tz-text);
    border: 1px solid var(--tz-border-medium);
    border-radius: var(--tz-r-full);
    padding: 10px 18px;
    transition: border-color .2s, color .2s;
  }
  .svc-cross__link:hover { color: var(--tz-text); border-color: var(--tz-accent); }
</style>
