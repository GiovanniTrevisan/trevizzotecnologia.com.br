---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/site/Header.astro';
import Hero from '@/components/site/Hero.astro';
import Cenario from '@/components/site/Cenario.astro';
import ComoAjudamos from '@/components/site/ComoAjudamos.astro';
import PresencaDigital from '@/components/site/PresencaDigital.astro';
import AutomacaoIA from '@/components/site/AutomacaoIA.astro';
import SobMedida from '@/components/site/SobMedida.astro';
import Processo from '@/components/site/Processo.astro';
import Experiencia from '@/components/site/Experiencia.astro';
import Diagnostico from '@/components/site/Diagnostico.astro';
import FAQ from '@/components/site/FAQ.astro';
import FinalCTA from '@/components/site/FinalCTA.astro';
import Footer from '@/components/site/Footer.astro';
import WhatsAppButton from '@/components/site/WhatsAppButton.astro';
import { organization, website, localBusiness, webPage, faqPage } from '@/data/schema';
import { faqItems } from '@/data/faq';
import { abs } from '@/data/config';

const title = 'Criação de sites, automação e sistemas sob medida | Trevizzo';
const description =
  'Presença digital, automação com IA e sistemas sob medida desenvolvidos a partir da realidade de cada empresa. O projeto começa por um diagnóstico gratuito.';
const pageUrl = abs('');

// Approved <h1> (plan §2.2 / copy doc): "Sites, automação com IA e sistemas
// sob medida para sua empresa crescer." Tokenized as 9 spans — not one per
// literal word — so the Hero's --i-staggered animation renders exactly 9
// words as specified, with accentFrom=6 putting the accent on the final
// clause "para sua / empresa / crescer." (= "para sua empresa crescer").
const heroWords = ['Sites,', 'automação', 'com IA', 'e', 'sistemas', 'sob medida', 'para sua', 'empresa', 'crescer.'];
---

<Layout
  title={title}
  description={description}
  schemas={[
    organization({ includeOfferCatalog: true }),
    website(),
    localBusiness('bh'),
    localBusiness('barueri'),
    webPage({ url: pageUrl, name: title, description }),
    faqPage(faqItems),
  ]}
>
  <Header />
  <main id="conteudo">
    <Hero
      kicker="Tecnologia criada para fazer seu negócio avançar."
      words={heroWords}
      accentFrom={6}
    />
    <Cenario />
    <ComoAjudamos />
    <PresencaDigital />
    <AutomacaoIA />
    <SobMedida />
    <Processo />
    <Experiencia />
    <Diagnostico />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
